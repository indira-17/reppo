+
+        if iter_idx < off_end:
+            return 1.0
+
+        if iter_idx < mix_end and mix_len > 0:
+            mix_progress = (iter_idx - off_end) / max(1, mix_len - 1)
+            return float(max(0.0, mixed_offline_start_ratio * (1.0 - mix_progress)))
